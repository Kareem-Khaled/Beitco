{
  "name": "beitco",
  "version": "0.1.0",
  "private": true,
  "description": "Egypt's first social network for real estate",
  "author": "Beitco <hello@beitco.app>",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "web": "pnpm --filter tanstack_start_ts dev",
    "api": "pnpm --filter @beitco/api start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "pnpm --filter @beitco/api prisma migrate dev",
    "db:seed": "pnpm --filter @beitco/api prisma db seed",
    "db:studio": "pnpm --filter @beitco/api prisma studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
