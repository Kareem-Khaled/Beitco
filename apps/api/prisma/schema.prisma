// Beitco - Prisma schema (bed-level trust-first housing marketplace)
// Post-pivot schema (B-0). Mirrors apps/web/src/lib/beitco/types.ts.
// UUID PKs; snake_case columns via @map; soft deletes via deletedAt.
// Enums use Latin values; Arabic display is mapped in the app layer.
// The pre-pivot social/video schema lives on the `old` git branch.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  renter
  owner
  both
}

enum Gender {
  male
  female
}

enum GenderPref {
  male
  female
  any
}

enum RentalGenderPolicy {
  male_only
  female_only
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum PropertyType {
  apartment
  room
  bed
}

enum UnitType {
  apartment
  studio
  duplex
  roof
  villa
}

enum PropertyStatus {
  draft
  pending_approval
  published
  paused
  rejected
}

enum RentalMode {
  whole
  by_room
  by_bed
}

enum ListingType {
  rent
  sale
}

enum SaleStatus {
  available
  sold
}

enum BedStatus {
  available
  occupied
  reserved
}

enum FurnishedPref {
  furnished
  unfurnished
  any
}

enum Occupation {
  student
  employee
  remote
  freelance
  other
}

enum NearbyType {
  metro
  university
  transit
  mall
  hospital
  supermarket
  other
}

enum LinkStatus {
  pending
  confirmed
}

enum LeadStatus {
  pending
  approved
  declined
  completed
}

enum LeadIntent {
  viewing
  booking
}

enum LeadUnitKind {
  bed
  room
  whole
}

enum MessageType {
  text
  viewing_request
}

enum NotificationType {
  lead
  message
  review
  verification
  link
}

model User {
  id     String   @id @default(uuid())
  phone  String   @unique
  name   String
  avatar String?
  role   UserRole @default(renter)
  gender Gender?

  isAdmin            Boolean            @default(false)
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  trust              Float              @default(5.0)
  trustBreakdown     Json?              @map("trust_breakdown")
  responseRate       Int?               @map("response_rate")
  renterReputation   Float?             @map("renter_reputation")
  renterReviewsCount Int                @default(0) @map("renter_reviews_count")

  notificationPrefs Json?          @map("notification_prefs")
  profile           RenterProfile?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  properties         Property[]            @relation("PropertyOwner")
  reviewsAuthored    Review[]              @relation("ReviewAuthor")
  reviewHelpfulVotes ReviewHelpfulVote[]
  renterReviewsAbout RenterReview[]        @relation("RenterReviewSubject")
  renterReviewsBy    RenterReview[]        @relation("RenterReviewAuthor")
  responseEvents     ResponseEvent[]
  questionsAsked     Question[]            @relation("QuestionAsker")
  questionsAnswered  Question[]            @relation("QuestionAnswerer")
  threadsAsOwner     Thread[]              @relation("ThreadOwner")
  threadsAsRenter    Thread[]              @relation("ThreadRenter")
  messages           Message[]
  leads              Lead[]
  tenancies          Tenancy[]
  occupantLinks      Occupant[]
  savedListings      SavedListing[]
  savedSearches      SavedSearch[]
  notifications      Notification[]
  verificationReqs   VerificationRequest[]

  @@index([role])
  @@index([verificationStatus])
  @@map("users")
}

model RenterProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  intent            ListingType    @default(rent)
  budgetMin         Int?           @map("budget_min")
  budgetMax         Int?           @map("budget_max")
  areas             String[]
  lookingFor        PropertyType[] @map("looking_for")
  moveInBy          DateTime?      @map("move_in_by")
  mustHaveAmenities String[]       @map("must_have_amenities")
  nearMetro         Boolean        @default(false) @map("near_metro")
  metroLines        String[]       @map("metro_lines")
  maxWalkMinutes    Int?           @map("max_walk_minutes")
  nearTransit       Boolean        @default(false) @map("near_transit")
  furnishedPref     FurnishedPref? @map("furnished_pref")
  housematesGender  GenderPref?    @map("housemates_gender")
  occupation        Occupation?
  smoker            Boolean?
  bio               String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("renter_profiles")
}

model Property {
  id      String @id @default(uuid())
  ownerId String @map("owner_id")
  owner   User   @relation("PropertyOwner", fields: [ownerId], references: [id])

  title       String
  description String @default("")
  area        String
  address     String @default("")
  lat         Float?
  lng         Float?

  type        PropertyType
  status      PropertyStatus @default(draft)
  listingType ListingType    @default(rent) @map("listing_type")
  rentalMode  RentalMode?    @map("rental_mode")

  unitType  UnitType? @map("unit_type")
  bedrooms  Int?
  bathrooms Int?
  floor     Int?
  sizeM2    Int?      @map("size_m2")
  furnished Boolean   @default(false)

  price        Int
  priceFrom    Int?        @map("price_from")
  wholePrice   Int?        @map("whole_price")
  wholeStatus  BedStatus?  @map("whole_status")
  nightlyPrice Int?        @map("nightly_price")
  salePrice    Int?        @map("sale_price")
  saleStatus   SaleStatus? @map("sale_status")
  negotiable   Boolean     @default(false)

  rentToGender RentalGenderPolicy? @map("rent_to_gender")

  images    String[]
  amenities String[]
  costs     Json     @default("[]")

  trust          Float   @default(5.0)
  trustBreakdown Json?   @map("trust_breakdown")
  verified       Boolean @default(false)
  quality        Json?
  reviewsCount   Int     @default(0) @map("reviews_count")
  residents      Int     @default(0)

  rejectionReason String?   @map("rejection_reason")
  moderatedAt     DateTime? @map("moderated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rooms         Room[]
  wholeOccupant Occupant?      @relation("PropertyWholeOccupant")
  nearby        NearbyPlace[]
  customSpecs   CustomSpec[]
  reviews       Review[]
  questions     Question[]
  threads       Thread[]
  leads         Lead[]
  tenancies     Tenancy[]
  savedBy       SavedListing[]
  renterReviews RenterReview[]

  @@index([status])
  @@index([ownerId])
  @@index([type])
  @@index([listingType])
  @@index([area])
  @@map("properties")
}

model Room {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name     String
  features String[]
  sizeM2   Int?       @map("size_m2")
  price    Int?
  status   BedStatus?

  beds     Bed[]
  occupant Occupant?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("rooms")
}

model Bed {
  id     String @id @default(uuid())
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  label    String
  status   BedStatus @default(available)
  price    Int
  features String[]

  occupant Occupant?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@map("beds")
}

model Occupant {
  id         String      @id @default(uuid())
  name       String?
  phone      String?
  moveInDate DateTime?   @map("move_in_date")
  notes      String?
  userId     String?     @map("user_id")
  user       User?       @relation(fields: [userId], references: [id])
  linkStatus LinkStatus? @map("link_status")

  bedId           String?   @unique @map("bed_id")
  bed             Bed?      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  roomId          String?   @unique @map("room_id")
  room            Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  wholePropertyId String?   @unique @map("whole_property_id")
  wholeProperty   Property? @relation("PropertyWholeOccupant", fields: [wholePropertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("occupants")
}

model NearbyPlace {
  id         String     @id @default(uuid())
  propertyId String     @map("property_id")
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       NearbyType
  name       String
  line       String?
  minutes    Int?

  @@index([propertyId])
  @@map("nearby_places")
}

model CustomSpec {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  value      String

  @@index([propertyId])
  @@map("custom_specs")
}

model Review {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String?  @map("author_id")
  author     User?    @relation("ReviewAuthor", fields: [authorId], references: [id])

  authorName  String @map("author_name")
  initials    String @default("")
  monthsLived Int    @map("months_lived")
  rating      Float
  body        String
  scores      Json?
  helpful     Int    @default(0)
  ownerReply  Json?  @map("owner_reply")

  createdAt DateTime @default(now()) @map("created_at")

  helpfulVotes ReviewHelpfulVote[]

  @@index([propertyId])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id       String @id @default(uuid())
  reviewId String @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

model RenterReview {
  id         String   @id @default(uuid())
  tenancyId  String   @map("tenancy_id")
  tenancy    Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  renterId   String   @map("renter_id")
  renter     User     @relation("RenterReviewSubject", fields: [renterId], references: [id])
  ownerId    String   @map("owner_id")
  owner      User     @relation("RenterReviewAuthor", fields: [ownerId], references: [id])
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id])

  rating Float
  scores Json
  body   String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenancyId, ownerId])
  @@index([renterId])
  @@map("renter_reviews")
}

model ResponseEvent {
  id                   String    @id @default(uuid())
  ownerId              String    @map("owner_id")
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  threadId             String    @unique @map("thread_id")
  thread               Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  firstRenterMessageAt DateTime  @map("first_renter_message_at")
  firstOwnerReplyAt    DateTime? @map("first_owner_reply_at")

  @@index([ownerId])
  @@map("response_events")
}

model Question {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  askerId    String?  @map("asker_id")
  asker      User?    @relation("QuestionAsker", fields: [askerId], references: [id])
  askerName  String   @map("asker_name")
  body       String

  answer       String?
  answererId   String?   @map("answerer_id")
  answerer     User?     @relation("QuestionAnswerer", fields: [answererId], references: [id])
  answererName String?   @map("answerer_name")
  answeredAt   DateTime? @map("answered_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("questions")
}

model Thread {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String   @map("owner_id")
  owner      User     @relation("ThreadOwner", fields: [ownerId], references: [id])
  renterId   String   @map("renter_id")
  renter     User     @relation("ThreadRenter", fields: [renterId], references: [id])

  lastMessageAt DateTime @default(now()) @map("last_message_at")
  unreadForId   String?  @map("unread_for_id")

  messages      Message[]
  responseEvent ResponseEvent?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([propertyId, renterId])
  @@index([ownerId])
  @@index([renterId])
  @@map("threads")
}

model Message {
  id       String      @id @default(uuid())
  threadId String      @map("thread_id")
  thread   Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String      @map("sender_id")
  sender   User        @relation(fields: [senderId], references: [id])
  body     String
  type     MessageType @default(text)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId])
  @@map("messages")
}

model Lead {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId   String   @map("renter_id")
  renter     User     @relation(fields: [renterId], references: [id])
  renterName String   @map("renter_name")

  status        LeadStatus  @default(pending)
  intent        LeadIntent?
  preferredDate DateTime?   @map("preferred_date")
  note          String?

  units LeadUnit[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([renterId])
  @@map("leads")
}

model LeadUnit {
  id       String       @id @default(uuid())
  leadId   String       @map("lead_id")
  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  label    String
  kind     LeadUnitKind
  roomId   String?      @map("room_id")
  roomName String?      @map("room_name")
  bedId    String?      @map("bed_id")
  price    Int?

  @@map("lead_units")
}

model Tenancy {
  id          String    @id @default(uuid())
  propertyId  String    @map("property_id")
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  moveInDate  DateTime  @map("move_in_date")
  moveOutDate DateTime? @map("move_out_date")
  monthsLived Int       @default(0) @map("months_lived")

  renterReviews RenterReview[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([propertyId])
  @@map("tenancies")
}

model SavedListing {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@map("saved_listings")
}

model SavedSearch {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String
  params Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_searches")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  propertyId String?          @map("property_id")
  threadId   String?          @map("thread_id")
  readAt     DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model VerificationRequest {
  id     String             @id @default(uuid())
  userId String             @map("user_id")
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status VerificationStatus @default(pending)

  idDocUrl        String? @map("id_doc_url")
  selfieUrl       String? @map("selfie_url")
  ownershipDocUrl String? @map("ownership_doc_url")
  rejectionReason String? @map("rejection_reason")

  submittedAt DateTime  @default(now()) @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}
