# Test-mode env overrides (Vitest runs with mode="test").
# Vite loads this OVER .env in test mode, so a developer's local
# .env (VITE_USE_API=true, used to point the running app at the backend)
# can't flip component tests into API mode — those assert against the
# in-memory mock store and would otherwise hit the network and time out.
VITE_USE_API=false
