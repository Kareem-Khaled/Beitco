# ─── Beitco Environment Variables ───────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beitco?schema=public

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Meilisearch ────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=beitco_master_key_dev

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-character-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-64-character-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── OTP ────────────────────────────────────────────
OTP_SECRET=change-me-to-a-random-32-character-string
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ─── SMS delivery (PROD-2) ──────────────────────────
# 'console' (default) logs the code (dev, no real SMS). 'http' sends via a
# generic gateway below. With a live provider the OTP is delivered by SMS and
# is NEVER returned to the client.
SMS_PROVIDER=console
# When SMS_PROVIDER=http:
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=Beitco

# ─── Mux (Video) ───────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ─── Paymob (Payments) ─────────────────────────────
PAYMOB_API_KEY=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ─── Google OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple OAuth ────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Firebase (Push Notifications) ──────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Object storage / image uploads (PROD-1) ───────
# S3 OR any S3-compatible store (Cloudflare R2, MinIO). Leave the keys blank to
# disable presigned uploads  -  the listing wizard then falls back to inline
# (downscaled base64) images, so dev needs no setup.
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=beitco-uploads
# Optional: S3-compatible endpoint (e.g. https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Optional: public CDN base for stored objects (e.g. https://cdn.beitco.com).
# If unset, the public URL falls back to the S3 virtual-hosted URL.
S3_PUBLIC_URL=

# ─── App Config ─────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# ─── Rate Limiting ──────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ─── Observability (OBS) ────────────────────────────
# Logging: pino level (debug|info|warn|error). JSON in prod, pretty in dev.
LOG_LEVEL=info
# Error tracking (Sentry). Leave UNSET to disable (no-op in dev).
# API:
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Web (Vite  -  must be prefixed VITE_):
VITE_SENTRY_DSN=
