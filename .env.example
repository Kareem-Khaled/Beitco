# ─── Beitco Environment Variables ───────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beitco?schema=public

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Meilisearch ────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=beitco_master_key_dev

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-character-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-64-character-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── OTP ────────────────────────────────────────────
OTP_SECRET=change-me-to-a-random-32-character-string
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ─── Mux (Video) ───────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ─── Paymob (Payments) ─────────────────────────────
PAYMOB_API_KEY=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ─── Google OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple OAuth ────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Firebase (Push Notifications) ──────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── AWS (Production) ──────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=beitco-uploads

# ─── App Config ─────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# ─── Rate Limiting ──────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
